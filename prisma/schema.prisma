// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PlotFlag {
	id			Int     @id @default(autoincrement())
	uuid 		String
	name		String
	description	String
}

model GameItem {
	id			Int		@id	@default(autoincrement())
	name		String
	mapKey		String
	displayName	String
	description	String
}

model Cutscene {
	id			Int		@id @default(autoincrement())
	name		String
	description	String
	uuid		String
	characters	CutsceneCharacter[]
	category	CutsceneCategory @relation(fields: [categoryId], references: [id])
	categoryId	Int
}

model CutsceneCharacter {
	id			Int			@id @default(autoincrement())
	index		Int
	description	String	
	cutscene	Cutscene	@relation(fields: [cutsceneId], references: [id])
	cutsceneId	Int
}

model CutsceneCategory {
	id			Int			@id @default(autoincrement())
	description	String
	categories	Cutscene[]
}
